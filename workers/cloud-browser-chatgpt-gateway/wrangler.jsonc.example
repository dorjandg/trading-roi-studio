{
  // Staging-only template. DO NOT deploy until a distinct OAUTH_KV namespace
  // and dedicated Google OAuth client have been configured and checked.
  "name": "cloud-browser-chatgpt-stage",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-21",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "REPLACE_WITH_NEW_STAGING_OAUTH_KV_NAMESPACE_ID" }
  ]
}
